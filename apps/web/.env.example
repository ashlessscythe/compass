# Compass web (`apps/web`)
# Copy to `.env.local` and fill in secrets. Next.js loads this directory automatically.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# `.env.local` is gitignored. Never commit real credentials.
# Full local + Production (Vercel) guide: docs/environment.md
#
# Schema lives in `prisma/schema.prisma`. Local:
#   pnpm --filter @compass/web db:migrate
# Deploy (Vercel build / Docker start):
#   pnpm --filter @compass/web db:deploy

# --- Public (safe in the browser; NEXT_PUBLIC_* is inlined at build time) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only: Postgres (waitlist + Sync replica tables) ---
# Inventory truth stays on-device SQLite. See docs/sync-protocol.md.
#
# Neon: DATABASE_URL = pooled (`-pooler` host). DIRECT_URL = unpooled (same URL, no `-pooler`).
# Local Postgres: both can be the same connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/compass
DIRECT_URL=postgresql://user:password@localhost:5432/compass

# --- Optional: waitlist email (not wired yet) ---
# RESEND_API_KEY=
# WAITLIST_NOTIFY_TO=

# --- Sync protocol v0 ---
# Production (Vercel): set APPLE_CLIENT_ID; leave COMPASS_SYNC_DEV_SECRET unset.
# Local/simulator only:
# APPLE_CLIENT_ID=app.compass.mobile
# COMPASS_SYNC_DEV_SECRET=local-dev-only
# COMPASS_API_SECRET=

# --- RevenueCat (unused in v0; server entitlement checks are Later) ---
# Secret REST API key only. Never NEXT_PUBLIC_. Never pass to Flutter.
# The public Apple SDK key (appl_…) is a mobile --dart-define, not this file.
# REVENUECAT_SECRET_API_KEY=
