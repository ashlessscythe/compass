{
  "name": "@compass/web",
  "version": "0.1.0",
  "private": true,
  "description": "Compass marketing website",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "sh scripts/prisma-generate.sh && next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .turbo",
    "postinstall": "sh scripts/prisma-generate.sh",
    "db:generate": "sh scripts/prisma-generate.sh",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "sh scripts/migrate-deploy.sh",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio"
  },
  "dependencies": {
    "@compass/api": "workspace:*",
    "@compass/branding": "workspace:*",
    "@compass/ui": "workspace:*",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.10",
    "geist": "^1.3.1",
    "lucide-react": "^0.479.0",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@next/eslint-plugin-next": "^15.5.22",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.3",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2"
  }
}
