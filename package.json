{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "description": "Compass — offline-first asset management. Know where everything is.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@compass/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "nanoid": "^3.3.18",
      "postcss": ">=8.5.23",
      "sharp": "^0.35.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "@resvg/resvg-js",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  }
}
